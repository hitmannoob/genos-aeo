# Core database. Use an absolute path such as /var/lib/genos/genos.sqlite3
# in production. Keep the file on a local EBS volume, not EFS/NFS.
SQLITE_PATH=./data/genos.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000

# Firebase browser authentication
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Firebase Admin authentication
FIREBASE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional local Firebase Auth emulator
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# AI routing
# Signed-in users enter their OpenRouter key in the browser. The key stays in
# localStorage and is sent only with provider-backed API requests.
# This optional server fallback is used for trusted SERVICE_API_SECRET calls.
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# OPENROUTER_OPENAI_MODEL=openai/gpt-5.4-mini
# OPENROUTER_GOOGLE_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar-pro

# Trusted server-to-server access. Generate independent random values.
SERVICE_API_SECRET=replace_with_at_least_32_random_characters
ADMIN_API_SECRET=replace_with_a_different_32_character_secret
ADMIN_EMAILS=admin@example.com

# Optional Sentry monitoring. Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-only values for uploading source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
