{
  "name": "genos",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI answer engine visibility analytics for brands.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:port": "next dev -p 3001",
    "health": "node scripts/health-check.mjs",
    "config:check": "node validate-config.js",
    "db:migrate": "node scripts/run-sqlite-migrations.mjs",
    "db:verify": "node scripts/verify-sqlite-schema.mjs",
    "db:verify-runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-sqlite-runtime.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.62.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.101.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^1.22.0",
    "next": "^16.2.11",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.26",
      "sharp": "^0.35.3"
    },
    "uuid": "^11.1.1"
  }
}
