rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Brand setup creates ids as `${uid}_${cleanDomain}`. During the atomic
    // createBrandWithCredits transaction we must read the target brand doc
    // before it exists to enforce "already exists" checks. Existing-doc reads
    // still go through resource.data.userId below; this only covers the
    // pre-create existence check for the caller's own namespace.
    function isOwnPendingBrandId(brandId) {
      return isSignedIn() && brandId.matches('^' + request.auth.uid + '_.*$');
    }
    
    // Allow authenticated users to read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Allow authenticated users to read/write their own brand data.
    // `resource` is null on create, and also null on reads against a doc that
    // doesn't exist yet. The latter case happens in createBrandWithCredits,
    // which probes the target doc id inside a client transaction before
    // creating it.
    match /v8userbrands/{brandId} {
      allow read: if (resource == null && isOwnPendingBrandId(brandId)) ||
        (resource != null && isOwner(resource.data.userId));
      allow update, delete: if resource != null && isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // Allow authenticated users to read/write their own detailed query results
    match /v8detailed_query_results/{resultId} {
      allow read, update, delete: if resource != null && isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // Allow authenticated users to read/write their own brand analytics
    match /v8_user_brand_analytics/{analyticsId} {
      allow read, update, delete: if resource != null && isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    // Allow authenticated users to read/write their own lifetime analytics
    match /v8_lifetime_brand_analytics/{analyticsId} {
      allow read, update, delete: if resource != null && isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}
