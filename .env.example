# Core database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/genos
# Local Postgres normally uses false. Hosted databases normally use true.
POSTGRES_SSL=false
# Keep true for production unless your provider explicitly requires otherwise.
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# Optional pool tuning
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# AI routing
# Browser users enter their OpenRouter key on the landing page; it is stored
# only in browser localStorage and sent with provider requests.
# This server-side fallback is optional and is useful only for trusted service calls.
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# OPENROUTER_OPENAI_MODEL=openai/gpt-5.4-mini
# OPENROUTER_GOOGLE_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar-pro

# Trusted server-to-server access. Generate independent random values.
SERVICE_API_SECRET=replace_with_at_least_32_random_characters
ADMIN_API_SECRET=replace_with_a_different_32_character_secret

# Optional Sentry monitoring. Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-only values for uploading source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
